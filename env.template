# Periskope API Configuration
# Copy this file to .env and fill in your actual values

PERISKOPE_API_KEY=your_api_key_here
PERISKOPE_PHONE_NUMBER=your_phone_number_here

# Webhook Server Configuration
# Replace with your publicly accessible server URL (use ngrok for local development)
WEBHOOK_URL=https://your-server-url.com/webhook
PORT=3000

# Optional: Webhook signing key for verification
PERISKOPE_SIGNING_KEY=your_signing_key_here

# Database Configuration
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_bot
# Set to 'true' if using SSL (e.g., for cloud databases)
DATABASE_SSL=false

# OpenAI API Configuration (optional)
OPENAI_API_KEY=your_openai_api_key_here

# MCP Server Configuration
# MCP server port (default: 3001)
MCP_PORT=3001
# MCP server host (default: 0.0.0.0)
MCP_HOST=0.0.0.0
# Comma-separated list of allowed host headers (optional)
# If MCP_HOST is 0.0.0.0 and this is not set, host validation is disabled
# Example: MCP_ALLOWED_HOSTS=15.206.195.249,localhost,127.0.0.1
# SSL Certificate paths for HTTPS (both required for HTTPS)
# SSL_KEY_PATH=/path/to/private.key
# SSL_CERT_PATH=/path/to/certificate.crt
