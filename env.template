# Periskope API Configuration
# Copy this file to .env and fill in your actual values

PERISKOPE_API_KEY=your_api_key_here
PERISKOPE_PHONE_NUMBER=your_phone_number_here

# Webhook Server Configuration
# Replace with your publicly accessible server URL (use ngrok for local development)
# This URL will be used for webhook registration. Can be HTTP or HTTPS.
# Run 'npm run register-webhooks' to register this URL with Periskope for all webhook events.
WEBHOOK_URL=http://your-server-url.com/webhook
PORT=3000

# Optional: Webhook signing key for verification
PERISKOPE_SIGNING_KEY=your_signing_key_here
# Optional: Integration name for webhook registration (default: 'whatsapp-bot')
WEBHOOK_INTEGRATION_NAME=whatsapp-bot

# Database Configuration
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_bot
# Set to 'true' if using SSL (e.g., for cloud databases)
DATABASE_SSL=false

# AI API Configuration (optional)
OPENAI_API_KEY=your_openai_api_key_here
XAI_API_KEY=your_xai_api_key_here

# MCP Admin Session Configuration (optional)
# Set a unique session ID that will act as an admin session.
# Admin sessions bypass all session checks and cannot be destroyed.
# Generate a UUID: node -e "console.log(require('crypto').randomUUID())"
MCP_ADMIN_SESSION_ID=your_admin_session_id_here
